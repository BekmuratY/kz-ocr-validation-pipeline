# Disable model source connectivity checks (recommended for offline runs)
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Matplotlib cache dir in a writable location
MPLCONFIGDIR=/tmp/mpl

# Optional: force PaddleOCR to use local cached models only
# PADDLEOCR_TEXT_DET_MODEL_DIR=/absolute/path/to/PP-OCRv5_server_det
# PADDLEOCR_TEXT_REC_MODEL_DIR=/absolute/path/to/en_PP-OCRv5_mobile_rec
